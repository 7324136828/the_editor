{
  "name": "vscode-office-studio",
  "version": "1.0.0",
  "description": "Editable VS Code-style Office workspace with local versioned saves, native exports, plugins and read-only MCP.",
  "type": "module",
  "main": "./dist/vscode-office-studio.umd.cjs",
  "module": "./dist/vscode-office-studio.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vscode-office-studio.js",
      "require": "./dist/vscode-office-studio.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs --static",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.config.lib.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "playwright test",
    "coverage:requirements": "node scripts/requirements-coverage.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.mjs\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@xmldom/xmldom": "^0.9.12",
    "prettier": "^3.9.8",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=24"
  }
}
