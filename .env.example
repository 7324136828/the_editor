# Preferred ports. If either is busy, run.py advances until it finds a free one.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# --lan overrides this address unless --host is also supplied.
BACKEND_HOST=127.0.0.1

# Document storage configuration
OFFICE_DATA_DIR=.office-data
OFFICE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Database path for jobs and documents
OFFICE_DB_PATH=data/office.db

# Optional AI / Gemini API key for advanced generative chat (leave empty for local built-in assistant)
GEMINI_API_KEY=
